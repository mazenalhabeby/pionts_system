{% comment %}
  Pionts Loyalty Widget — shared initialization logic.
  Reads API credentials from shop metafields set during app install.

  Required assigns:
    pionts_mode     — 'floating' or 'embedded'
    pionts_container — CSS selector for embedded mode (optional)
{% endcomment %}

{% assign pionts_key = shop.metafields.pionts.public_key %}
{% assign pionts_secret = shop.metafields.pionts.hmac_secret %}
{% assign pionts_api_url = shop.metafields.pionts.api_url | default: 'https://app.pionts.com' %}

{% if pionts_key != blank %}
  <script src="{{ pionts_api_url }}/sdk/loyalty.js" defer></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var config = {
        projectKey: {{ pionts_key | json }},
        mode: {{ pionts_mode | default: 'floating' | json }},
        apiBase: {{ pionts_api_url | json }}
      };
      {% if pionts_container %}
        config.container = {{ pionts_container | json }};
      {% endif %}
      {% if customer %}
        config.customer = {
          email: {{ customer.email | json }},
          name: {{ customer.first_name | default: customer.name | json }},
          hmac: {{ customer.email | hmac_sha256: pionts_secret | json }}
        };
      {% endif %}
      Loyalty.init(config);
    });
  </script>
{% endif %}
